<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\Simorgh.AI.Core\Simorgh.AI.Core.csproj"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="System.Diagnostics.DiagnosticSource"/>
    </ItemGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Built-in extensions for Simorgh.AI agents in .NET, including instant and on-demand tool calling, agent logging, token usage metrics, and in-memory run cancellation.</Description>
        <PackageTags>$(PackageTags) llm ai-agents tool-calling function-calling tool-discovery observability logging metrics token-usage opentelemetry</PackageTags>
    </PropertyGroup>

</Project>
