<Project>
    <PropertyGroup>
        <!-- Multi-target: netstandard2.0 serves .NET Framework 4.6.1+ and older stacks;
             net8.0 gives modern consumers a dependency-free asset (no Microsoft.Bcl.AsyncInterfaces). -->
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>

        <Version>0.1.8</Version>
        <Authors>Yasin Sadjadi</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <PackageProjectUrl>https://github.com/YasinSadjadi/Simorgh.AI</PackageProjectUrl>
        <RepositoryUrl>$(PackageProjectUrl)</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>simorgh.png</PackageIcon>
        <PackageReleaseNotes Condition="'$(Version)' == '0.1.8'">Updated NuGet listings with author information, GitHub links, a package icon, a quickstart, and package-specific descriptions and search tags.</PackageReleaseNotes>
        <PackageTags>simorgh ai dotnet csharp artificial-intelligence</PackageTags>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)assets/simorgh.png" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
