<Project>
    <PropertyGroup>
        <!-- Multi-target: netstandard2.0 serves .NET Framework 4.6.1+ and older stacks;
             net8.0 gives modern consumers a dependency-free asset (no Microsoft.Bcl.AsyncInterfaces). -->
        <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>

        <Version>0.1.8</Version>
        <Authors>Simorgh AI Contributors</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageId>$(MSBuildProjectName)</PackageId>
        <PackageProjectUrl>https://github.com/YasinSadjadi/Simorgh.AI</PackageProjectUrl>
        <RepositoryUrl>$(PackageProjectUrl)</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>ai;dotnet;artificial-intelligence</PackageTags>
        <IsPackable>true</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
